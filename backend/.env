# HealthWeave Environment Configuration
# Copy to .env and fill in your values

# Application
APP_NAME=HealthWeave
APP_ENV=development
DEBUG=true
SECRET_KEY=healthweave-dev-secret-key-32chars!

# Database (Docker container mapped to host port 5433)
DATABASE_URL=postgresql+asyncpg://healthweave:healthweave@localhost:5433/healthweave

# Redis
REDIS_URL=redis://localhost:6379/0

# AI (get keys from anthropic.com and platform.openai.com)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PRIMARY_LLM=claude-sonnet-4-6

# Object Storage — MinIO (Docker, mapped to host port 9002)
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=healthweave-documents
S3_ACCESS_KEY=healthweave
S3_SECRET_KEY=healthweave123
S3_REGION=us-east-1

# Notifications (optional)
FCM_SERVER_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://app.healthweave.in"]
