# ────────────────────────────────────────────────────────────────────────────
# HealthWeave — Production Environment Variables
# Copy these into DigitalOcean App Platform → api service → Environment Variables
# Never commit actual values to git.
# ────────────────────────────────────────────────────────────────────────────

APP_ENV=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Get from https://platform.openai.com (needed for embeddings)
OPENAI_API_KEY=sk-...

# DigitalOcean Spaces (Bangalore region)
# Create a Space at: cloud.digitalocean.com → Spaces → Create Space (blr1 region)
# Get keys from: cloud.digitalocean.com → API → Spaces Keys
S3_ENDPOINT=https://blr1.digitaloceanspaces.com
S3_REGION=blr1
S3_BUCKET=healthweave-documents
S3_ACCESS_KEY=your_spaces_access_key
S3_SECRET_KEY=your_spaces_secret_key

# Injected automatically by DO App Platform from the managed database
# DATABASE_URL=  ← DO fills this in; do NOT set manually

# Optional: add your custom domain once DNS is pointing to DO
# CORS_ORIGINS=https://your-frontend-url.ondigitalocean.app,https://app.yourdomain.com
