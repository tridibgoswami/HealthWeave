# HealthWeave Environment Configuration
# Copy to .env and fill in your values

# Application
APP_NAME=HealthWeave
APP_ENV=development
DEBUG=true
SECRET_KEY=healthweave-dev-secret-key-32chars!

# Database
DATABASE_URL=postgresql+asyncpg://healthweave:healthweave@localhost:5432/healthweave

# Redis
REDIS_URL=redis://localhost:6379/0

# AI (get keys from anthropic.com and platform.openai.com)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PRIMARY_LLM=claude-sonnet-4-6

# Object Storage (AWS S3 or MinIO)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=healthweave-documents
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=ap-south-1

# Notifications (optional)
FCM_SERVER_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# CORS
CORS_ORIGINS=http://localhost:3000,https://app.healthweave.in
